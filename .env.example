# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL / PostGIS Configuration (Cloud SQL or local Docker)
DATABASE_URL="postgresql+psycopg://hydromonitor:hydromonitor_dev@localhost:5432/hydromonitor"

# Google Cloud & Firebase Configuration
GOOGLE_CLOUD_PROJECT="gen-lang-client-0257614236"
FIREBASE_PROJECT_ID="gen-lang-client-0257614236"
GCS_BUCKET_NAME="hydromonitor-geodata-bucket"

# Copernicus EWDS / GloFAS Configuration (loaded via Secret Manager in Cloud Run)
GLOFAS_EWDS_URL="https://ewds.climate.copernicus.eu/api"
GLOFAS_EWDS_API_KEY=""
GLOFAS_VERSION="5.0"
GLOFAS_HISTORICAL_DATASET="cems-glofas-historical"
GLOFAS_FORECAST_DATASET="cems-glofas-forecast"

# Hub'Eau Configuration (Official Eaufrance API v1)
HUBEAU_BASE_URL="https://hubeau.eaufrance.fr/api/v1/temperature"
HUBEAU_TIMEOUT_SECONDS="15"
HUBEAU_MAX_RETRIES="3"

